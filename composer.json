{
    "name": "yii2-extensions/bootstrap6",
    "type": "yii2-extension",
    "description": "Bootstrap 6 widgets, forms, and asset bundles for Yii2.",
    "keywords": [
        "bootstrap",
        "bootstrap6",
        "widget",
        "yii2",
        "yii2-extension"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ui-awesome/html-helper": "^0.7",
        "ui-awesome/html-svg": "^0.6.1",
        "yiisoft/yii2": "~2.0.55 || ^22.0@dev"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "maglnet/composer-require-checker": "^4.1",
        "php-forge/coding-standard": "^0.3",
        "php-forge/foxy": "^0.4",
        "php-forge/support": "^0.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "phpunit/phpunit": "^12.5",
        "yii2-extensions/phpstan": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\bootstrap6\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\bootstrap6\\tests\\": "tests"
        }
    },
    "extra": {
        "bootstrap": "yii2\\extensions\\bootstrap6\\Bootstrap",
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        },
        "foxy": true,
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-forge/foxy": true,
            "phpstan/extension-installer": true,
            "yiisoft/yii2-composer": true
        },
        "foxy": {
            "manager": "native"
        }
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "mutation": "php -d memory_limit=-1 vendor/bin/infection --threads=4 --ignore-msi-with-no-mutations --min-msi=100 --min-covered-msi=100",
        "mutation-static": [
            "Composer\\Config::disableProcessTimeout",
            "php -d memory_limit=-1 vendor/bin/infection --initial-tests-php-options='-d memory_limit=-1' --test-framework-extra-args='-d memory_limit=-1' --threads=4 --ignore-msi-with-no-mutations --min-msi=100 --min-covered-msi=100 --static-analysis-tool=phpstan --static-analysis-tool-options='--memory-limit=-1'"
        ],
        "rector": "./vendor/bin/rector process",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "./vendor/bin/phpunit",
        "ecs-check": "./vendor/bin/ecs check --ansi",
        "quality": [
            "actionlint",
            "codespell --config .github/linters/.codespellrc --skip=./.git,./vendor/*,./node_modules/*,./internal/*,./.phpunit.cache/*,./code_coverage/*,./runtime/*",
            "editorconfig-checker -config .github/linters/.editorconfig-checker.json",
            "markdownlint-cli2 --config .github/linters/.markdown-lint.yml '**/*.md' '#vendor/**' '#node_modules/**' '#internal/**' '#runtime/**'",
            "prettier --check --config .prettierrc.json --ignore-path .prettierignore '**/*.md' '**/*.{yml,yaml}' '!runtime/**' '!internal/**'",
            "yamllint -d 'extends: default\nrules:\n  comments:\n    min-spaces-from-content: 1\n  line-length: disable\n  truthy: disable' .github"
        ],
        "zizmor": "zizmor --persona=pedantic .github",
        "security": [
            "@zizmor",
            "gitleaks git --config .github/linters/.gitleaks.toml --redact"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
