{
    $schema: "./vendor/infection/infection/resources/schema.json",
    ignoreMsiWithNoMutations: true,
    initialTestsPhpOptions: "-d memory_limit=-1",
    logs: {
        text: "php://stderr",
        stryker: {
            report: "main",
        },
    },
    minCoveredMsi: 100,
    minMsi: 100,
    mutators: {
        "@default": true,
        ArrayItemRemoval: {
            // Equivalent on Yii 22: the core `fileInput()` merges `inputOptions` again; the merge serves Yii 2.0.x.
            ignore: ["yii2\\extensions\\bootstrap6\\ActiveField::fileInput"],
        },
    },
    source: {
        directories: ["src"],
    },
    staticAnalysisToolOptions: "--memory-limit=-1",
    testFrameworkExtraArgs: "-d memory_limit=-1",
    threads: "max",
    timeout: 30,
}
